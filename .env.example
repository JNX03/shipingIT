# Copy this placeholder template to .env.local (ignored); preserve existing local files.
# Public configuration: every EXPO_PUBLIC value is visible in the bundled app.
# Supabase URL/key are required for sign-in and gameplay; AI and billing are optional.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_AUTH_REDIRECT_URL=shipaton-nextgen://auth/callback
# Enable only after the matching provider is configured in this Supabase project.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_MENTOR_API_URL=
EXPO_PUBLIC_INTERVIEW_API_URL=
EXPO_PUBLIC_OPPORTUNITY_API_URL=

# RevenueCat public SDK keys, never RevenueCat secret API keys.
# Only the build script's verified Android TestStoreQa variant sets test-store-qa.
# Release/unset blocks Test Store SDK initialization; JavaScript __DEV__ is not the native flag.
EXPO_PUBLIC_REVENUECAT_BUILD_MODE=release
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=shipingit_pro
# Explicit sale gate. Keep false until terms, account setup, and purchase tests are complete.
EXPO_PUBLIC_ENABLE_BUILDER_PURCHASES=false
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=false
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# SERVER ONLY. Keep these in the service environment, never in Expo public vars.
# For the optional Node server, copy only this section to an ignored .env.server.local.
# Example: node --env-file=.env.server.local src/server/index.mjs
OPENROUTER_API_KEY=
# Free-only OpenRouter model with structured outputs; server verifies current pricing.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MENTOR_DAILY_LIMIT=20
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
HOST=127.0.0.1
PORT=8787
