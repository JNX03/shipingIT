# Copy to supabase/.env.local (ignored). Do not place server credentials in Expo public variables.
OPENROUTER_API_KEY=
# Fixed free model; the server rechecks live catalog pricing before each generation.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
NEXTGEN_SUPABASE_PUBLISHABLE_KEY=
# Set exact origins for the current preview/deployed web app. Native requests omit Origin.
ALLOWED_ORIGINS=http://127.0.0.1:8085,http://localhost:8093,http://localhost:8097,http://127.0.0.1:8097
